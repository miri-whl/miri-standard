{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://miri-whl.github.io/schemas/api-graph-v1.json",
  "title": "Miri Standard API Graph",
  "description": "Schema for api-graph.json - AST-derived API relationship graph. Only structure that can be evidenced from source is represented: nodes carry their kind, edges carry a declared relationship. Scored or inferred values (centrality, usage frequency) and synthesized usage workflows are deliberately NOT part of this contract - a generator must not invent them.",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "pattern": "^\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Build-time generation timestamp (ISO 8601)"
    },
    "nodes": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "$ref": "#/definitions/graph_node"
        }
      },
      "additionalProperties": false,
      "description": "API components as graph nodes, keyed by component name"
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/definitions/graph_edge"},
      "description": "Declared relationships between API components"
    }
  },
  "definitions": {
    "graph_node": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["class", "function", "method", "module", "constant"],
          "description": "Type of API component"
        }
      }
    },
    "graph_edge": {
      "type": "object",
      "required": ["from", "to", "relationship"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "description": "Source component name"
        },
        "to": {
          "type": "string",
          "description": "Target component name"
        },
        "relationship": {
          "type": "string",
          "enum": ["uses", "returns", "creates", "extends", "implements", "calls"],
          "description": "Type of relationship, derived from the source (inheritance, return type, call site)"
        },
        "methods": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Methods involved in the relationship, when evidenced from source"
        }
      }
    }
  }
}

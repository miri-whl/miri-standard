{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://miri-whl.github.io/schemas/usage-patterns-v1.json",
  "title": "Miri Standard Usage Patterns",
  "description": "Schema for usage-patterns.json - Pre-extracted, categorized code patterns",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "patterns"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "pattern": "^\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When patterns were generated"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/usage_pattern"
      },
      "description": "List of usage patterns"
    },
    "categories": {
      "type": "object",
      "patternProperties": {
        "^[a-z_][a-z0-9_]*$": {
          "$ref": "#/definitions/category"
        }
      },
      "additionalProperties": false,
      "description": "Pattern categories"
    },
    "learning_paths": {
      "type": "object",
      "patternProperties": {
        "^[a-z_][a-z0-9_]*$": {
          "$ref": "#/definitions/learning_path"
        }
      },
      "additionalProperties": false,
      "description": "Structured learning progressions"
    }
  },
  "definitions": {
    "usage_pattern": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "complexity",
        "category",
        "code"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "description": "Unique pattern identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable pattern name"
        },
        "description": {
          "type": "string",
          "description": "What this pattern demonstrates"
        },
        "complexity": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "description": "Difficulty level"
        },
        "category": {
          "type": "string",
          "description": "Pattern category"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "Where this pattern sits among patterns of EQUAL `complexity` in a learning path. Lower comes first. Optional, and an absent value is NOT zero: a pattern declaring none sorts AFTER every pattern of equal complexity that declares one, so the majority who declare nothing cannot displace the few who do. Comparable only WITHIN one complexity level, so a `beginner` pattern declaring 9 still precedes an `advanced` one declaring 0: `complexity` already answers the coarse question, and two fields deciding one order is how they come to disagree. Equal values are a tie the producer breaks, and it MUST break that tie the same way on every build. The constraint this places on `learning_paths[*].patterns` is LINTER-DECIDABLE BUT NOT SCHEMA-EXPRESSIBLE, since draft-07 cannot compare one array's members against another array's contents; Agent Metadata \u00a74.2.1 states it. Requested by the miri-py team, whose generator had no orderable fact beyond `complexity` and was ordering learning paths by directory-walk order."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Searchable tags"
        },
        "code": {
          "type": "string",
          "description": "Complete, runnable code example"
        },
        "explanation": {
          "$ref": "#/definitions/explanation",
          "description": "Detailed explanation of the pattern"
        },
        "variations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/code_variation"
          },
          "description": "Alternative implementations"
        },
        "related_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of related patterns"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required knowledge or patterns. A set rendered as an array: position carries no meaning."
        },
        "estimated_time": {
          "type": "string",
          "description": "Time to understand/implement"
        },
        "antipatterns": {
          "type": "array",
          "description": "Known-wrong ways to use this surface, with the corrected form. This is the negative half of usage guidance \u2014 \"never construct this per request\", \"this is not thread-safe\", \"do not retry this error class\" \u2014 which has no other home in the standard. Author-declared: emit only where the package states it, never inferred.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Short name for the mistake"
              },
              "wrong_code": {
                "type": "string",
                "description": "The incorrect usage, as code"
              },
              "right_code": {
                "type": "string",
                "description": "The corrected usage, as code"
              },
              "why": {
                "type": "string",
                "description": "What goes wrong \u2014 the failure mode, not merely a style preference"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "correctness",
                  "security",
                  "performance",
                  "style"
                ],
                "description": "The kind of harm. `correctness` and `security` are the ones a consumer must surface before writing a call; `style` is advisory."
              }
            }
          }
        }
      }
    },
    "explanation": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Step-by-step breakdown"
        },
        "key_points": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Important concepts to understand"
        },
        "security_note": {
          "type": "string",
          "description": "Security considerations"
        },
        "performance_note": {
          "type": "string",
          "description": "Performance considerations"
        },
        "parameter_styles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Different parameter formats supported"
        }
      }
    },
    "code_variation": {
      "type": "object",
      "required": [
        "name",
        "code"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Variation name"
        },
        "code": {
          "type": "string",
          "description": "Alternative code implementation"
        },
        "description": {
          "type": "string",
          "description": "When to use this variation"
        }
      }
    },
    "category": {
      "type": "object",
      "required": [
        "name",
        "description",
        "patterns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Category display name"
        },
        "description": {
          "type": "string",
          "description": "What patterns in this category cover"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Pattern IDs in this category. A set rendered as an array: position carries no meaning, unlike `learning_path.patterns`."
        }
      }
    },
    "learning_path": {
      "type": "object",
      "required": [
        "name",
        "description",
        "patterns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Learning path name"
        },
        "description": {
          "type": "string",
          "description": "What this path teaches"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered list of pattern IDs. The array AS PUBLISHED is the order a consumer reads, top to bottom, and a consumer MUST NOT re-sort it. Where the patterns it names declare `order`, the array MUST be consistent with them (Agent Metadata \u00a74.2.1)."
        },
        "estimated_total_time": {
          "type": "string",
          "description": "Total time for complete path"
        }
      }
    }
  }
}

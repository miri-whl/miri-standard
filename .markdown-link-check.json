{
  "ignorePatterns": [
    {
      "pattern": "^http://localhost"
    },
    {
      "pattern": "^https://localhost"
    },
    {
      "pattern": "^#"
    },
    {
      "pattern": "^https?://www\\.gnu\\.org/"
    },
    {
      "comment": "opensource.org returns 403 to every non-browser request, including with a browser User-Agent. The license text is not gone; the host refuses crawlers, exactly as gnu.org does.",
      "pattern": "^https?://opensource\\.org/"
    }
  ],
  "replacementPatterns": [],
  "httpHeaders": [
    {
      "urls": [
        "https://github.com/"
      ],
      "headers": {
        "Accept-Encoding": "zstd, br, gzip, deflate"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [
    200,
    206
  ]
}
